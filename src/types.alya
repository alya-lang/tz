## tz Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Zone rule model for IANA-style timezone conversion with recurring
## current-era daylight saving rules.

# ───────────────────────────────────────────────────────────────
# Error Type
# ───────────────────────────────────────────────────────────────

## Error thrown when a zone name is unknown or a zoned conversion fails.
##
## ### Fields
## - `message`: Human-readable failure description.
pub struct TzError
    message: string
end

# ───────────────────────────────────────────────────────────────
# Zone Rule Model
# ───────────────────────────────────────────────────────────────

## Recurring daylight-saving rule for one IANA zone (current era).
##
## Offsets are minutes east of UTC (UTC+3 -> 180). A fixed zone sets
## `dst_start_month` to 0 and ignores the remaining DST fields.
## Transition rules are nth-weekday-of-month: `week` 1-4 selects the nth
## occurrence, 5 selects the last; `weekday` follows `std/time`
## (`epoch_to_date` convention, Sunday is 0). When `dst_start_utc` is 1
## the start hour is already UTC (e.g. EU rules); otherwise it is local
## wall time (start uses the standard offset, end uses the daylight
## offset). Southern-hemisphere zones set the start month after the end
## month (e.g. October start, April end).
##
## ### Fields
## - `name`: IANA zone name (`"Europe/Istanbul"`).
## - `std_abbr`: Standard-time abbreviation (`"EST"`, `"+03"`).
## - `dst_abbr`: Daylight abbreviation (`"EDT"`; `""` when unused).
## - `std_offset_min`: Standard offset, minutes east of UTC.
## - `dst_offset_min`: Daylight offset, minutes east of UTC.
## - `dst_start_month`: DST start month (1-12), 0 for fixed zones.
## - `dst_start_week`: Start week (1-4 nth, 5 last).
## - `dst_start_weekday`: Start weekday (0 Sunday .. 6 Saturday).
## - `dst_start_hour`: Start transition hour (0-23).
## - `dst_start_utc`: 1 when the start hour is UTC, 0 when local wall.
## - `dst_end_month`: DST end month (1-12), 0 for fixed zones.
## - `dst_end_week`: End week (1-4 nth, 5 last).
## - `dst_end_weekday`: End weekday (0 Sunday .. 6 Saturday).
## - `dst_end_hour`: End transition hour (0-23).
## - `dst_end_utc`: 1 when the end hour is UTC, 0 when local wall.
pub struct TzRule
    name: string,
    std_abbr: string,
    dst_abbr: string,
    std_offset_min: int,
    dst_offset_min: int,
    dst_start_month: int,
    dst_start_week: int,
    dst_start_weekday: int,
    dst_start_hour: int,
    dst_start_utc: int,
    dst_end_month: int,
    dst_end_week: int,
    dst_end_weekday: int,
    dst_end_hour: int,
    dst_end_utc: int
end

## Factory constructor for a fixed-offset zone (no daylight saving).
##
## ### Parameters
## - `name`: IANA zone name.
## - `abbr`: Zone abbreviation.
## - `offset_min`: Offset minutes east of UTC.
##
## ### Returns
## A fixed `TzRule` with DST fields zeroed.
##
## ### Examples
## ```alya
## let r = fixed_rule("Asia/Tokyo", "JST", 540)
## ```
pub function fixed_rule(name: string, abbr: string, offset_min: int) -> TzRule
    return TzRule {
        name: name,
        std_abbr: abbr,
        dst_abbr: "",
        std_offset_min: offset_min,
        dst_offset_min: offset_min,
        dst_start_month: 0,
        dst_start_week: 0,
        dst_start_weekday: 0,
        dst_start_hour: 0,
        dst_start_utc: 0,
        dst_end_month: 0,
        dst_end_week: 0,
        dst_end_weekday: 0,
        dst_end_hour: 0,
        dst_end_utc: 0
    }
end

## Factory constructor for a daylight-saving zone.
##
## ### Parameters
## - `name`: IANA zone name.
## - `std_abbr`: Standard-time abbreviation.
## - `dst_abbr`: Daylight abbreviation.
## - `std_offset_min`: Standard offset, minutes east of UTC.
## - `dst_offset_min`: Daylight offset, minutes east of UTC.
## - `sm`: DST start month (1-12).
## - `sw`: Start week (1-4 nth, 5 last).
## - `sd`: Start weekday (0 Sunday .. 6 Saturday).
## - `sh`: Start transition hour (0-23).
## - `su`: 1 when the start hour is UTC, 0 when local wall.
## - `em`: DST end month (1-12).
## - `ew`: End week (1-4 nth, 5 last).
## - `ed`: End weekday (0 Sunday .. 6 Saturday).
## - `eh`: End transition hour (0-23).
## - `eu`: 1 when the end hour is UTC, 0 when local wall.
##
## ### Returns
## A daylight-saving `TzRule`.
pub function dst_rule(name: string, std_abbr: string, dst_abbr: string, std_offset_min: int, dst_offset_min: int, sm: int, sw: int, sd: int, sh: int, su: int, em: int, ew: int, ed: int, eh: int, eu: int) -> TzRule
    return TzRule {
        name: name,
        std_abbr: std_abbr,
        dst_abbr: dst_abbr,
        std_offset_min: std_offset_min,
        dst_offset_min: dst_offset_min,
        dst_start_month: sm,
        dst_start_week: sw,
        dst_start_weekday: sd,
        dst_start_hour: sh,
        dst_start_utc: su,
        dst_end_month: em,
        dst_end_week: ew,
        dst_end_weekday: ed,
        dst_end_hour: eh,
        dst_end_utc: eu
    }
end

## Copies a rule into a freshly-owned struct.
##
## Returned rules must not borrow the lookup table: the table is a
## per-call temporary the compiler is free to release on return, so
## callers get an owned copy (see alya-lang/alya#79).
##
## ### Parameters
## - `r`: Source rule.
##
## ### Returns
## An owned copy of `r`.
pub function tzrule_copy(r: TzRule) -> TzRule
    return TzRule {
        name: r.name,
        std_abbr: r.std_abbr,
        dst_abbr: r.dst_abbr,
        std_offset_min: r.std_offset_min,
        dst_offset_min: r.dst_offset_min,
        dst_start_month: r.dst_start_month,
        dst_start_week: r.dst_start_week,
        dst_start_weekday: r.dst_start_weekday,
        dst_start_hour: r.dst_start_hour,
        dst_start_utc: r.dst_start_utc,
        dst_end_month: r.dst_end_month,
        dst_end_week: r.dst_end_week,
        dst_end_weekday: r.dst_end_weekday,
        dst_end_hour: r.dst_end_hour,
        dst_end_utc: r.dst_end_utc
    }
end

## Returns 1 when the rule carries a daylight-saving schedule, 0 for fixed zones.
##
## ### Parameters
## - `self`: Zone rule inspected.
##
## ### Returns
## 1 when `dst_start_month` is non-zero, 0 otherwise.
pub function TzRule.has_dst(self: TzRule) -> bool
    if self.dst_start_month == 0
        return false
    end
    return true
end
