## tz Conversion Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Zone-aware conversion over `std/time` (UTC epoch arithmetic) and the
## bundled rule table in `./tzdata/zones.alya`.

import "std/time"
import "./types.alya"
import "./tzdata/zones.alya"
@cfg(feature = "windows")
import "./tzdata/windows.alya"

# --- Lookup ---

## Resolves a zone name, alias, or Windows key to its rule, or null when unknown.
##
## ### Parameters
## - `name`: IANA zone name, alias (`"UTC"` resolves to `"Etc/UTC"`), or
##   Windows key (`"Turkey Standard Time"` resolves via the bundled table).
##
## ### Returns
## The matching `TzRule`, or null when the zone is not bundled.
##
## ### Examples
## ```alya
## let r = tz_rule("Europe/Istanbul")
## ```
pub function engine_tz_rule(name: string)
    let cname = tzdata_canonical(name)
    for r in tzdata_rules()
        if r.name == cname
            return r
        end
    end
    @cfg(feature = "windows")
    let wname = tzdata_windows_iana(name)
    @cfg(feature = "windows")
    if wname != "" and wname != cname
        for r in tzdata_rules()
            if r.name == wname
                return r
            end
        end
    end
    return null
end

## Returns 1 when the zone name or alias is bundled, 0 otherwise.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
##
## ### Returns
## 1 for known zones, 0 otherwise.
pub function engine_tz_is_valid(name: string) -> int
    if engine_tz_rule(name) is null
        return 0
    end
    return 1
end

## Returns all bundled IANA zone names.
##
## ### Parameters
## None.
##
## ### Returns
## Array of bundled zone name strings.
pub function engine_tz_names() -> array
    let res = []
    for r in tzdata_rules()
        res.push(r.name)
    end
    return res
end

function _tz_require(name: string)
    let r = engine_tz_rule(name)
    if r is null
        throw TzError { message: f"Unknown timezone: {name}" }
    end
    return r
end

# --- Transition Math ---

function _tz_nth_weekday(year: int, month: int, week: int, weekday: int) -> int
    let dim: int = days_in_month(month, year)
    let first_wd: int = epoch_to_date(date_ymd_to_epoch(year, month, 1))["weekday"]
    let delta: int = (weekday - first_wd) % 7
    if delta < 0
        delta += 7
    end
    let day: int = 1 + delta
    if week >= 5
        while day + 7 <= dim
            day += 7
        end
        return day
    end
    day = day + (week - 1) * 7
    if day > dim
        day = day - 7
    end
    return day
end

function _tz_transition_utc(rule, year: int, is_start: int) -> int
    let month: int = rule.dst_end_month
    let week: int = rule.dst_end_week
    let weekday: int = rule.dst_end_weekday
    let hour: int = rule.dst_end_hour
    let as_utc: int = rule.dst_end_utc
    let base_min: int = rule.dst_offset_min
    if is_start == 1
        month = rule.dst_start_month
        week = rule.dst_start_week
        weekday = rule.dst_start_weekday
        hour = rule.dst_start_hour
        as_utc = rule.dst_start_utc
        base_min = rule.std_offset_min
    end
    let day: int = _tz_nth_weekday(year, month, week, weekday)
    let civil: int = date_ymd_to_epoch(year, month, day) + (hour * 3600)
    if as_utc == 1
        return civil
    end
    return civil - base_min * 60
end

# --- Offsets ---

## Returns the UTC offset in minutes active in the zone at the epoch.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Offset minutes east of UTC (UTC+3 -> 180).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_tz_offset_min(name: string, epoch: int) -> int
    let rule = _tz_require(name)
    if rule.has_dst() == 0
        return rule.std_offset_min
    end
    let year: int = epoch_to_date(epoch)["year"]
    let start_utc: int = _tz_transition_utc(rule, year, 1)
    let end_utc: int = _tz_transition_utc(rule, year, 0)
    if rule.dst_start_month <= rule.dst_end_month
        if epoch >= start_utc and epoch < end_utc
            return rule.dst_offset_min
        end
        return rule.std_offset_min
    end
    if epoch >= start_utc or epoch < end_utc
        return rule.dst_offset_min
    end
    return rule.std_offset_min
end

## Returns the zone abbreviation active in the zone at the epoch.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Active abbreviation (`"EST"`/`"EDT"`, `""` for fixed zones without one).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_tz_abbrev(name: string, epoch: int) -> string
    let rule = _tz_require(name)
    if rule.has_dst() == 0
        return rule.std_abbr
    end
    if engine_tz_offset_min(name, epoch) == rule.dst_offset_min
        return rule.dst_abbr
    end
    return rule.std_abbr
end

## Returns 1 when daylight saving is active in the zone at the epoch.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## 1 when the daylight offset applies, 0 otherwise (fixed zones always 0).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_tz_is_dst(name: string, epoch: int) -> int
    let rule = _tz_require(name)
    if rule.has_dst() == 0
        return 0
    end
    if engine_tz_offset_min(name, epoch) == rule.dst_offset_min
        return 1
    end
    return 0
end

## Formats a minute offset as `+HH:MM` (zero renders as `+00:00`).
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Offset string such as `"+03:00"` or `"-05:00"`.
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_tz_offset_str(name: string, epoch: int) -> string
    let off: int = engine_tz_offset_min(name, epoch)
    let sign: string = "+"
    let v: int = off
    if v < 0
        sign = "-"
        v = 0 - v
    end
    return f"{sign}{_tz_pad2(v / 60)}:{_tz_pad2(v % 60)}"
end

function _tz_pad2(n: int) -> string
    if n < 10
        return f"0{n}"
    end
    return str(n)
end

# --- Conversions ---

## Converts a UTC epoch to a zoned calendar map.
##
## ### Parameters
## - `epoch`: UTC epoch seconds.
## - `name`: IANA zone name, alias, or Windows key.
##
## ### Returns
## Calendar map (`year`, `month`, `day`, `hour`, `minute`, `second`,
## `weekday` with Sunday 0) plus `offset_min`, `abbr`, and `iana`.
##
## ### Throws
## `TzError` when the zone is not bundled.
##
## ### Examples
## ```alya
## let z = epoch_to_zoned(1704067200, "Asia/Shanghai")
## # z["hour"] == 8
## ```
pub function engine_epoch_to_zoned(epoch: int, name: string)
    let rule = _tz_require(name)
    let off: int = engine_tz_offset_min(name, epoch)
    let local = epoch_to_date(epoch + off * 60)
    local["offset_min"] = off
    if off == rule.dst_offset_min and rule.has_dst() == 1
        local["abbr"] = rule.dst_abbr
    else
        local["abbr"] = rule.std_abbr
    end
    local["iana"] = rule.name
    return local
end

## Converts the current UTC time to a zoned calendar map.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
##
## ### Returns
## Zoned calendar map for `time()` (see `epoch_to_zoned` for the shape).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_zoned_now(name: string)
    return engine_epoch_to_zoned(time(), name)
end

## Formats a zoned calendar map as `YYYY-MM-DD HH:MM:SS+HH:MM`.
##
## ### Parameters
## - `d`: Zoned calendar map from `epoch_to_zoned` (must carry `offset_min`).
##
## ### Returns
## Wall time with numeric offset, e.g. `"2024-01-01 08:00:00+08:00"`.
pub function engine_format_zoned(d) -> string
    let off: int = d["offset_min"]
    let sign: string = "+"
    let v: int = off
    if v < 0
        sign = "-"
        v = 0 - v
    end
    let tail: string = f"{sign}{_tz_pad2(v / 60)}:{_tz_pad2(v % 60)}"
    return f"{d["year"]}-{_tz_pad2(d["month"])}-{_tz_pad2(d["day"])} {_tz_pad2(d["hour"])}:{_tz_pad2(d["minute"])}:{_tz_pad2(d["second"])}{tail}"
end

## Converts a zoned wall-time map to a UTC epoch.
##
## A single correction pass resolves the wall reading against the active
## offset: spring-forward gaps resolve forward, fall-back folds resolve to
## the standard-time (second) occurrence.
##
## ### Parameters
## - `d`: Calendar map with `year`, `month`, `day`, `hour`, `minute`, and `second`.
## - `name`: IANA zone name, alias, or Windows key.
##
## ### Returns
## UTC epoch seconds.
##
## ### Throws
## `TzError` when the zone is not bundled or the calendar date is invalid.
pub function engine_zoned_to_epoch(d, name: string) -> int
    let rule = _tz_require(name)
    let year = d["year"]
    let month = d["month"]
    let day = d["day"]
    if month < 1 or month > 12 or day < 1 or day > days_in_month(month, year)
        throw TzError { message: "Invalid calendar date for zoned conversion" }
    end
    let civil: int = date_ymd_to_epoch(year, month, day) + (d["hour"] * 3600) + (d["minute"] * 60) + d["second"]
    let guess: int = civil - rule.std_offset_min * 60
    let actual: int = engine_tz_offset_min(name, guess)
    let epoch: int = civil - actual * 60
    let recheck: int = engine_tz_offset_min(name, epoch)
    if recheck != actual
        epoch = civil - recheck * 60
    end
    return epoch
end

# --- Discovery ---

## Returns the bundled data revision identifier.
##
## ### Parameters
## None.
##
## ### Returns
## Opaque revision string for the bundled rule set.
pub function engine_tzdata_version() -> string
    return "2026a-era recurring subset"
end

## Returns bundled zone names under a region prefix.
##
## ### Parameters
## - `prefix`: Region prefix such as `"Europe/"` or `"America/"`.
##
## ### Returns
## Matching IANA zone names (empty array when none match).
pub function engine_tz_by_region(prefix: string) -> array
    let res = []
    for n in engine_tz_names()
        if substring(n, 0, len(prefix)) == prefix
            res.push(n)
        end
    end
    return res
end

## Returns bundled zone names using an offset.
##
## A zone matches when its standard offset equals `offset_min`, or when it
## has daylight saving and its daylight offset equals `offset_min`.
##
## ### Parameters
## - `offset_min`: Offset minutes east of UTC.
##
## ### Returns
## Matching IANA zone names (empty array when none match).
pub function engine_tz_by_offset(offset_min: int) -> array
    let res = []
    for r in tzdata_rules()
        if r.std_offset_min == offset_min
            res.push(r.name)
        elif r.dst_start_month != 0 and r.dst_offset_min == offset_min
            res.push(r.name)
        end
    end
    return res
end

# --- Transitions ---

## Returns the DST transition instants for a zone year.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `year`: Gregorian year.
##
## ### Returns
## Map with `has_dst` (1/0) and UTC epoch `start_utc`/`end_utc`
## (0 for fixed zones).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_tz_dst_range(name: string, year: int)
    let rule = _tz_require(name)
    if rule.has_dst() == 0
        return { "has_dst": 0, "start_utc": 0, "end_utc": 0 }
    end
    return {
        "has_dst": 1,
        "start_utc": _tz_transition_utc(rule, year, 1),
        "end_utc": _tz_transition_utc(rule, year, 0)
    }
end

## Returns the next DST transition instant strictly after the epoch.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Next transition UTC epoch, or null for fixed zones.
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_next_transition(name: string, epoch: int)
    let rule = _tz_require(name)
    if rule.has_dst() == 0
        return null
    end
    let year: int = epoch_to_date(epoch)["year"]
    let start_utc: int = _tz_transition_utc(rule, year, 1)
    let end_utc: int = _tz_transition_utc(rule, year, 0)
    if rule.dst_start_month <= rule.dst_end_month
        if epoch < start_utc
            return start_utc
        end
        if epoch < end_utc
            return end_utc
        end
        return _tz_transition_utc(rule, year + 1, 1)
    end
    if epoch < end_utc
        return end_utc
    end
    if epoch < start_utc
        return start_utc
    end
    return _tz_transition_utc(rule, year + 1, 0)
end

# --- Wall-time string parsing ---

function _tz_parse_digits(s: string) -> int
    if len(s) == 0
        return 0
    end
    let i: int = 0
    while i < len(s)
        let c: int = ord(char_at(s, i))
        if c < 48 or c > 57
            return 0
        end
        i += 1
    end
    return 1
end

function _tz_parse_num(s: string, pos: int, count: int) -> int
    if pos < 0 or count <= 0 or pos + count > len(s)
        return -1
    end
    let part: string = substring(s, pos, count)
    if _tz_parse_digits(part) == 0
        return -1
    end
    return to_int(part)
end

## Parses a wall-time string in the zone into a UTC epoch.
##
## Accepts `YYYY-MM-DD`, `YYYY-MM-DDTHH:MM:SS`, and the space-separated
## form, with an optional ignored fraction (`.mmm`). No zone suffix is
## read: the wall reading belongs to `name` (see `zoned_to_epoch` for
## gap/fold behavior). The UTC-startup complement of `parse_iso8601`.
##
## ### Parameters
## - `s`: Wall-time string.
## - `name`: IANA zone name, alias, or Windows key.
##
## ### Returns
## UTC epoch seconds.
##
## ### Throws
## `TzError` when the string is malformed, the date is invalid, or the
## zone is not bundled.
##
## ### Examples
## ```alya
## parse_zoned("2024-01-01 08:00:00", "Asia/Shanghai") # 1704067200
## ```
pub function engine_parse_zoned(s: string, name: string) -> int
    let n: int = len(s)
    if n < 10
        throw TzError { message: f"Invalid wall time (too short): {s}" }
    end
    let year: int = _tz_parse_num(s, 0, 4)
    let month: int = _tz_parse_num(s, 5, 2)
    let day: int = _tz_parse_num(s, 8, 2)
    if year < 0 or char_at(s, 4) != "-" or char_at(s, 7) != "-"
        throw TzError { message: f"Invalid wall date (expected YYYY-MM-DD): {s}" }
    end
    if month < 1 or month > 12 or day < 1 or day > days_in_month(month, year)
        throw TzError { message: f"Invalid calendar date: {s}" }
    end
    if n == 10
        return engine_zoned_to_epoch({ "year": year, "month": month, "day": day, "hour": 0, "minute": 0, "second": 0 }, name)
    end
    let sep: string = char_at(s, 10)
    if sep != "T" and sep != "t" and sep != " "
        throw TzError { message: f"Invalid separator (expected T): {s}" }
    end
    if n < 19
        throw TzError { message: f"Invalid wall time (expected HH:MM:SS): {s}" }
    end
    let hour: int = _tz_parse_num(s, 11, 2)
    let minute: int = _tz_parse_num(s, 14, 2)
    let second: int = _tz_parse_num(s, 17, 2)
    if hour < 0 or char_at(s, 13) != ":" or char_at(s, 16) != ":"
        throw TzError { message: f"Invalid wall time (expected HH:MM:SS): {s}" }
    end
    if minute < 0 or second < 0 or hour > 23 or minute > 59 or second > 59
        throw TzError { message: f"Wall time out of range: {s}" }
    end
    let pos: int = 19
    if pos < n and char_at(s, pos) == "."
        pos += 1
        let frac_start: int = pos
        while pos < n and _tz_parse_digits(char_at(s, pos)) == 1
            pos += 1
        end
        if pos == frac_start
            throw TzError { message: f"Invalid fraction (digits expected after .): {s}" }
        end
    end
    if pos != n
        throw TzError { message: f"Trailing characters: {s}" }
    end
    return engine_zoned_to_epoch({ "year": year, "month": month, "day": day, "hour": hour, "minute": minute, "second": second }, name)
end

## Formats a zoned calendar map with a custom token pattern.
##
## Tokens: `YYYY` year, `MM` month, `DD` day, `HH` hour (24h), `mm`
## minute, `ss` second, `Z` numeric offset (`+HH:MM`), `A` abbreviation.
## Any other character passes through literally.
##
## ### Parameters
## - `d`: Zoned calendar map from `epoch_to_zoned` (must carry `offset_min`).
## - `fmt`: Token pattern.
##
## ### Returns
## Formatted wall-time string.
##
## ### Examples
## ```alya
## format_zoned_custom(w, "DD.MM.YYYY HH:mm Z") # "01.01.2024 08:00 +08:00"
## ```
pub function engine_format_zoned_custom(d, fmt: string) -> string
    let res: string = ""
    let i: int = 0
    let n: int = len(fmt)
    while i < n
        if i + 4 <= n and substring(fmt, i, 4) == "YYYY"
            res += str(d["year"])
            i += 4
        elif i + 2 <= n and substring(fmt, i, 2) == "MM"
            res += _tz_pad2(d["month"])
            i += 2
        elif i + 2 <= n and substring(fmt, i, 2) == "DD"
            res += _tz_pad2(d["day"])
            i += 2
        elif i + 2 <= n and substring(fmt, i, 2) == "HH"
            res += _tz_pad2(d["hour"])
            i += 2
        elif i + 2 <= n and substring(fmt, i, 2) == "mm"
            res += _tz_pad2(d["minute"])
            i += 2
        elif i + 2 <= n and substring(fmt, i, 2) == "ss"
            res += _tz_pad2(d["second"])
            i += 2
        elif char_at(fmt, i) == "Z"
            let off: int = d["offset_min"]
            let sign: string = "+"
            let v: int = off
            if v < 0
                sign = "-"
                v = 0 - v
            end
            res += f"{sign}{_tz_pad2(v / 60)}:{_tz_pad2(v % 60)}"
            i += 1
        elif char_at(fmt, i) == "A"
            if d["abbr"] is null
                res += ""
            else
                res += d["abbr"]
            end
            i += 1
        else
            res += char_at(fmt, i)
            i += 1
        end
    end
    return res
end

## Formats a zoned calendar map as RFC 3339 with numeric offset.
##
## ### Parameters
## - `d`: Zoned calendar map from `epoch_to_zoned` (must carry `offset_min`).
##
## ### Returns
## Wall time such as `"2024-01-01T08:00:00+08:00"`.
pub function engine_format_rfc3339_zoned(d) -> string
    let off: int = d["offset_min"]
    let sign: string = "+"
    let v: int = off
    if v < 0
        sign = "-"
        v = 0 - v
    end
    let tail: string = f"{sign}{_tz_pad2(v / 60)}:{_tz_pad2(v % 60)}"
    return f"{d["year"]}-{_tz_pad2(d["month"])}-{_tz_pad2(d["day"])}T{_tz_pad2(d["hour"])}:{_tz_pad2(d["minute"])}:{_tz_pad2(d["second"])}{tail}"
end

## Adds whole hours on the absolute timeline, then re-zones.
##
## ### Parameters
## - `epoch`: UTC epoch seconds.
## - `name`: IANA zone name, alias, or Windows key.
## - `h`: Hours to add (may be negative).
##
## ### Returns
## Zoned calendar map `h` absolute hours later (see `epoch_to_zoned`).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_zoned_add_hours(epoch: int, name: string, h: int)
    return engine_epoch_to_zoned(epoch + h * 3600, name)
end

## Adds calendar days keeping the wall clock, then re-zones.
##
## Unlike `zoned_add_hours`, the wall time is preserved: adding 1 day to
## midnight always yields midnight, even across a DST transition.
##
## ### Parameters
## - `epoch`: UTC epoch seconds.
## - `name`: IANA zone name, alias, or Windows key.
## - `n`: Days to add (may be negative).
##
## ### Returns
## Zoned calendar map `n` calendar days later with the same wall time.
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function engine_zoned_add_days(epoch: int, name: string, n: int)
    let wall = engine_epoch_to_zoned(epoch, name)
    let shifted = epoch_to_date(date_ymd_to_epoch(wall["year"], wall["month"], wall["day"]) + n * 86400)
    let target: int = engine_zoned_to_epoch({ "year": shifted["year"], "month": shifted["month"], "day": shifted["day"], "hour": wall["hour"], "minute": wall["minute"], "second": wall["second"] }, name)
    return engine_epoch_to_zoned(target, name)
end
