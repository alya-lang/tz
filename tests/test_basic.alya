## Test suite for tz
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("tz Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Zone lookup & validity
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::tz_is_valid("Europe/Istanbul"), 1, "Istanbul is bundled")
    runner_assert_eq(r, pkg::tz_is_valid("Asia/Shanghai"), 1, "Shanghai is bundled")
    runner_assert_eq(r, pkg::tz_is_valid("America/New_York"), 1, "New_York is bundled")
    runner_assert_eq(r, pkg::tz_is_valid("UTC"), 1, "UTC alias resolves")
    runner_assert_eq(r, pkg::tz_is_valid("Moon/Sea"), 0, "unknown zone is invalid")
    runner_assert_eq(r, pkg::tz_is_valid(""), 0, "empty zone is invalid")

    runner_assert_str_eq(r, pkg::tz_canonical("UTC"), "Etc/UTC", "UTC canonicalizes to Etc/UTC")
    runner_assert_str_eq(r, pkg::tz_canonical("Europe/Berlin"), "Europe/Berlin", "canonical names pass through")

    let names = pkg::tz_names()
    runner_assert_eq(r, len(names), 79, "79 bundled zones")
    runner_assert_true(r, names_contains(names, "Pacific/Auckland"), "Auckland listed")

    let rule = pkg::tz_rule("Asia/Tokyo")
    runner_assert_str_eq(r, rule.std_abbr, "JST", "Tokyo abbr is JST")
    runner_assert_eq(r, rule.std_offset_min, 540, "Tokyo offset is +540")
    runner_assert_eq(r, rule.has_dst(), 0, "Tokyo is fixed")

    let ny = pkg::tz_rule("America/New_York")
    runner_assert_eq(r, ny.has_dst(), 1, "New_York has DST")

    let missing = pkg::tz_rule("Moon/Sea")
    runner_assert_true(r, missing is null, "unknown zone rule is null")

    # ═══════════════════════════════════════════════════════════
    # 2. Fixed-offset zones (exact)
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::tz_offset_min("Etc/UTC", 1704067200), 0, "UTC offset 0")
    runner_assert_eq(r, pkg::tz_offset_min("UTC", 1704067200), 0, "UTC alias offset 0")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Istanbul", 1704067200), 180, "Istanbul +180")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Istanbul", 1721068245), 180, "Istanbul +180 in summer")
    runner_assert_eq(r, pkg::tz_offset_min("Asia/Shanghai", 1704067200), 480, "Shanghai +480")
    runner_assert_eq(r, pkg::tz_offset_min("Asia/Tokyo", 1704067200), 540, "Tokyo +540")
    runner_assert_eq(r, pkg::tz_offset_min("Asia/Kolkata", 1704067200), 330, "Kolkata +330")
    runner_assert_eq(r, pkg::tz_offset_min("Pacific/Honolulu", 1704067200), 0 - 600, "Honolulu -600")
    runner_assert_eq(r, pkg::tz_offset_min("America/Sao_Paulo", 1704067200), 0 - 180, "Sao_Paulo -180")

    runner_assert_str_eq(r, pkg::tz_abbrev("Asia/Tokyo", 1704067200), "JST", "Tokyo abbrev JST")
    runner_assert_str_eq(r, pkg::tz_abbrev("Etc/UTC", 1704067200), "UTC", "UTC abbrev")

    # ═══════════════════════════════════════════════════════════
    # 3. Northern DST zones (US + EU rules)
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::tz_offset_min("America/New_York", 1704067200), 0 - 300, "NY EST in January")
    runner_assert_eq(r, pkg::tz_offset_min("America/New_York", 1721068245), 0 - 240, "NY EDT in July")
    runner_assert_str_eq(r, pkg::tz_abbrev("America/New_York", 1704067200), "EST", "NY abbrev EST")
    runner_assert_str_eq(r, pkg::tz_abbrev("America/New_York", 1721068245), "EDT", "NY abbrev EDT")

    runner_assert_eq(r, pkg::tz_offset_min("America/Los_Angeles", 1704067200), 0 - 480, "LA PST in January")
    runner_assert_eq(r, pkg::tz_offset_min("America/Los_Angeles", 1721068245), 0 - 420, "LA PDT in July")

    runner_assert_eq(r, pkg::tz_offset_min("Europe/London", 1704067200), 0, "London GMT in January")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/London", 1721068245), 60, "London BST in July")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Berlin", 1704067200), 60, "Berlin CET in January")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Berlin", 1721068245), 120, "Berlin CEST in July")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Athens", 1721068245), 180, "Athens EEST in July")

    # US 2024 transitions: Mar 10 07:00 UTC forward, Nov 3 06:00 UTC back
    runner_assert_eq(r, pkg::tz_offset_min("America/New_York", 1710053999), 0 - 300, "NY EST just before spring forward")
    runner_assert_eq(r, pkg::tz_offset_min("America/New_York", 1710054000), 0 - 240, "NY EDT just after spring forward")
    runner_assert_eq(r, pkg::tz_offset_min("America/New_York", 1730613599), 0 - 240, "NY EDT just before fall back")
    runner_assert_eq(r, pkg::tz_offset_min("America/New_York", 1730613600), 0 - 300, "NY EST just after fall back")

    # EU 2024 transitions: Mar 31 01:00 UTC forward, Oct 27 01:00 UTC back
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Berlin", 1711846799), 60, "Berlin CET just before spring forward")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Berlin", 1711846800), 120, "Berlin CEST just after spring forward")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Berlin", 1729990799), 120, "Berlin CEST just before fall back")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Berlin", 1729990800), 60, "Berlin CET just after fall back")

    # ═══════════════════════════════════════════════════════════
    # 4. Southern DST zones (season flipped)
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::tz_offset_min("Australia/Sydney", 1704067200), 660, "Sydney AEDT in January")
    runner_assert_eq(r, pkg::tz_offset_min("Australia/Sydney", 1721068245), 600, "Sydney AEST in July")
    runner_assert_eq(r, pkg::tz_offset_min("Pacific/Auckland", 1704067200), 780, "Auckland NZDT in January")
    runner_assert_eq(r, pkg::tz_offset_min("Pacific/Auckland", 1721068245), 720, "Auckland NZST in July")

    # ═══════════════════════════════════════════════════════════
    # 5. epoch_to_zoned conversion
    # ═══════════════════════════════════════════════════════════
    let sh = pkg::epoch_to_zoned(1704067200, "Asia/Shanghai")
    runner_assert_eq(r, sh["hour"], 8, "Shanghai wall hour is 08:00")
    runner_assert_eq(r, sh["day"], 1, "Shanghai day is 1")
    runner_assert_eq(r, sh["offset_min"], 480, "Shanghai offset_min is 480")
    runner_assert_str_eq(r, sh["abbr"], "CST", "Shanghai abbr is CST")
    runner_assert_str_eq(r, sh["iana"], "Asia/Shanghai", "iana echoes canonical name")

    let utc = pkg::epoch_to_zoned(0, "Etc/UTC")
    runner_assert_eq(r, utc["year"], 1970, "epoch 0 year is 1970")
    runner_assert_eq(r, utc["hour"], 0, "epoch 0 hour is 0")

    let nyc = pkg::epoch_to_zoned(1721068245, "America/New_York")
    runner_assert_eq(r, nyc["hour"], 14, "NY wall hour is 14:30 local")
    runner_assert_eq(r, nyc["minute"], 30, "NY wall minute is 30")
    runner_assert_str_eq(r, nyc["abbr"], "EDT", "NY abbr is EDT")

    # ═══════════════════════════════════════════════════════════
    # 6. zoned_to_epoch roundtrips
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::zoned_to_epoch(sh, "Asia/Shanghai"), 1704067200, "Shanghai roundtrip")
    runner_assert_eq(r, pkg::zoned_to_epoch(nyc, "America/New_York"), 1721068245, "NY DST roundtrip")
    runner_assert_eq(r, pkg::zoned_to_epoch(pkg::epoch_to_zoned(1704067200, "Pacific/Auckland"), "Pacific/Auckland"), 1704067200, "Auckland roundtrip")
    runner_assert_eq(r, pkg::zoned_to_epoch(pkg::epoch_to_zoned(1721068245, "Europe/Berlin"), "Europe/Berlin"), 1721068245, "Berlin DST roundtrip")

    # ═══════════════════════════════════════════════════════════
    # 7. Error paths (unknown zone, invalid date)
    # ═══════════════════════════════════════════════════════════
    let threw = 0
    try
        pkg::tz_offset_min("Moon/Sea", 0)
    catch err
        threw = 1
    end
    runner_assert_eq(r, threw, 1, "unknown zone offset throws")

    threw = 0
    try
        pkg::epoch_to_zoned(0, "Moon/Sea")
    catch err
        threw = 1
    end
    runner_assert_eq(r, threw, 1, "unknown zone conversion throws")

    threw = 0
    try
        pkg::zoned_to_epoch({ "year": 2023, "month": 2, "day": 29, "hour": 0, "minute": 0, "second": 0 }, "Etc/UTC")
    catch err
        threw = 1
    end
    runner_assert_eq(r, threw, 1, "Feb 29 2023 throws")

    # ═══════════════════════════════════════════════════════════
    # 8. Extended coverage: odd offsets, new zones, new API, Windows keys
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::tz_offset_min("Asia/Kathmandu", 1704067200), 345, "Kathmandu +345")
    runner_assert_eq(r, pkg::tz_offset_min("Australia/Eucla", 1704067200), 525, "Eucla +525")
    runner_assert_eq(r, pkg::tz_offset_min("Pacific/Marquesas", 1704067200), 0 - 570, "Marquesas -570")
    runner_assert_eq(r, pkg::tz_offset_min("America/St_Johns", 1704067200), 0 - 210, "St_Johns NST in January")
    runner_assert_eq(r, pkg::tz_offset_min("America/St_Johns", 1721068245), 0 - 150, "St_Johns NDT in July")
    runner_assert_eq(r, pkg::tz_offset_min("Australia/Adelaide", 1704067200), 630, "Adelaide ACDT in January")
    runner_assert_eq(r, pkg::tz_offset_min("Australia/Adelaide", 1721068245), 570, "Adelaide ACST in July")
    runner_assert_eq(r, pkg::tz_offset_min("Pacific/Chatham", 1704067200), 825, "Chatham +1345 in January")
    runner_assert_eq(r, pkg::tz_offset_min("Asia/Beirut", 1721068245), 180, "Beirut EEST in July")
    runner_assert_eq(r, pkg::tz_offset_min("Europe/Kyiv", 1721068245), 180, "Kyiv EEST in July")
    runner_assert_eq(r, pkg::tz_offset_min("America/Havana", 1721068245), 0 - 240, "Havana CDT in July")
    runner_assert_eq(r, pkg::tz_offset_min("Australia/Brisbane", 1704067200), 600, "Brisbane +600 fixed")
    runner_assert_eq(r, pkg::zoned_to_epoch(pkg::epoch_to_zoned(1704067200, "Asia/Kathmandu"), "Asia/Kathmandu"), 1704067200, "Kathmandu roundtrip")

    runner_assert_eq(r, pkg::tz_is_dst("America/New_York", 1704067200), 0, "NY not DST in January")
    runner_assert_eq(r, pkg::tz_is_dst("America/New_York", 1721068245), 1, "NY DST in July")
    runner_assert_eq(r, pkg::tz_is_dst("Asia/Tokyo", 1721068245), 0, "fixed zone never DST")
    runner_assert_eq(r, pkg::tz_is_dst("Australia/Sydney", 1704067200), 1, "Sydney DST in January")

    runner_assert_str_eq(r, pkg::tz_offset_str("Europe/Istanbul", 1704067200), "+03:00", "offset_str Istanbul")
    runner_assert_str_eq(r, pkg::tz_offset_str("America/New_York", 1704067200), "-05:00", "offset_str NY winter")
    runner_assert_str_eq(r, pkg::tz_offset_str("Etc/UTC", 0), "+00:00", "offset_str UTC")
    runner_assert_str_eq(r, pkg::tz_offset_str("Asia/Kathmandu", 0), "+05:45", "offset_str Kathmandu")

    runner_assert_str_eq(r, pkg::format_zoned(pkg::epoch_to_zoned(1704067200, "Asia/Shanghai")), "2024-01-01 08:00:00+08:00", "format_zoned Shanghai")
    runner_assert_str_eq(r, pkg::format_zoned(pkg::epoch_to_zoned(1721068245, "America/New_York")), "2024-07-15 14:30:45-04:00", "format_zoned NY summer")

    let now_wall = pkg::zoned_now("Etc/UTC")
    runner_assert_true(r, now_wall["year"] >= 2026, "zoned_now year sane")
    runner_assert_str_eq(r, now_wall["iana"], "Etc/UTC", "zoned_now iana")

    runner_assert_str_eq(r, pkg::tz_windows_iana("Turkey Standard Time"), "Europe/Istanbul", "windows table maps key")
    runner_assert_str_eq(r, pkg::tz_windows_iana("No Such Zone"), "", "windows table unknown is empty")

    let win_rule = pkg::tz_rule("Turkey Standard Time")
    let win_ok = 0
    if win_rule is null
        win_ok = 0
    else
        win_ok = 1
    end
    runner_assert_eq(r, win_ok, 1, "Windows key resolves to a rule")
    runner_assert_str_eq(r, win_rule.name, "Europe/Istanbul", "Windows key rule is Istanbul")
    runner_assert_eq(r, pkg::tz_offset_min("Eastern Standard Time", 1704067200), 0 - 300, "Windows key offset works")
    runner_assert_eq(r, pkg::epoch_to_zoned(1704067200, "Tokyo Standard Time")["hour"], 9, "Windows key conversion works")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

function names_contains(names, want: string) -> int
    for n in names
        if n == want
            return 1
        end
    end
    return 0
end

main()
