## Example usage and walkthrough for tz
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/time"
import "../src/lib.alya" as pkg

function main()
    say "=== tz Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. What time is it over there?
    # ───────────────────────────────────────────────────────────
    say "--- 1. Zone Wall Time ---"
    let epoch = 1704067200
    say "UTC instant:      " + format_iso(epoch)
    for z in ["Asia/Shanghai", "Europe/Istanbul", "America/New_York", "Pacific/Auckland"]
        let w = pkg::epoch_to_zoned(epoch, z)
        say z + " -> " + wall_str(w) + " " + w["abbr"] + " (UTC" + show_offset(w["offset_min"]) + ")"
    end
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Daylight saving in action
    # ───────────────────────────────────────────────────────────
    say "--- 2. DST Flip (New York 2024) ---"
    say "Jan offset: " + str(pkg::tz_offset_min("America/New_York", 1704067200)) + " min (" + pkg::tz_abbrev("America/New_York", 1704067200) + ")"
    say "Jul offset: " + str(pkg::tz_offset_min("America/New_York", 1721068245)) + " min (" + pkg::tz_abbrev("America/New_York", 1721068245) + ")"
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Wall time back to epoch
    # ───────────────────────────────────────────────────────────
    say "--- 3. Roundtrip ---"
    let wall = pkg::epoch_to_zoned(epoch, "Europe/Berlin")
    say "Berlin wall:  " + wall_str(wall)
    say "Back to epoch: " + str(pkg::zoned_to_epoch(wall, "Europe/Berlin"))
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Inventory
    # ───────────────────────────────────────────────────────────
    say "--- 4. Inventory ---"
    say "Bundled zones: " + str(len(pkg::tz_names()))
    say "UTC canonical: " + pkg::tz_canonical("UTC")
    say ""
    say "Done!"
end

function show_offset(off_min: int) -> string
    let sign = "+"
    let v = off_min
    if v < 0
        sign = "-"
        v = 0 - v
    end
    return sign + str(v / 60)
end

function pad2(n: int) -> string
    if n < 10
        return f"0{n}"
    end
    return str(n)
end

function wall_str(w) -> string
    return f"{w["year"]}-{pad2(w["month"])}-{pad2(w["day"])} {pad2(w["hour"])}:{pad2(w["minute"])}:{pad2(w["second"])}"
end

main()
