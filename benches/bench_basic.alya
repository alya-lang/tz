## Benchmark suite for tz
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("tz Micro-Benchmarks")

    # Bench 1: tz_offset_min on a fixed zone — 50k iterations
    let n1 = 50000
    bench_start(runner, n1)
    let i = 0
    while i < n1
        pkg::tz_offset_min("Asia/Tokyo", 1704067200)
        i += 1
    end
    bench_stop(runner, "tz_offset_min fixed 50k calls")

    # Bench 2: tz_offset_min on a DST zone — 20k iterations
    let n2 = 20000
    bench_start(runner, n2)
    let j = 0
    while j < n2
        pkg::tz_offset_min("America/New_York", 1721068245)
        j += 1
    end
    bench_stop(runner, "tz_offset_min DST 20k calls")

    # Bench 3: epoch_to_zoned roundtrip — 20k iterations
    let n3 = 20000
    bench_start(runner, n3)
    let k = 0
    while k < n3
        let w = pkg::epoch_to_zoned(1704067200, "Europe/Berlin")
        pkg::zoned_to_epoch(w, "Europe/Berlin")
        k += 1
    end
    bench_stop(runner, "zoned roundtrip 20k calls")

    # Bench 4: tz_rule lookup miss — 50k iterations
    let n4 = 50000
    bench_start(runner, n4)
    let m = 0
    while m < n4
        pkg::tz_is_valid("Moon/Sea")
        m += 1
    end
    bench_stop(runner, "tz_is_valid miss 50k calls")

    bench_summary(runner)
end

main()
