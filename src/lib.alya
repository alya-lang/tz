## tz Library Facade
##
## IANA timezone database and zone-aware datetime conversion for Alya:
## bundled current-era rules, UTC offset lookup, and epoch/wall-time
## conversion over `std/time`.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./tzdata/zones.alya"
import "./engine.alya"

# ───────────────────────────────────────────────────────────────
# Primary Facade APIs (thin delegates over ./engine.alya)
# ───────────────────────────────────────────────────────────────

## Resolves a zone name, alias, or Windows key to its rule, or null when unknown.
##
## ### Parameters
## - `name`: IANA zone name, alias (`"UTC"` resolves to `"Etc/UTC"`), or
##   Windows key (`"Turkey Standard Time"` resolves via the bundled table).
##
## ### Returns
## The matching `TzRule`, or null when the zone is not bundled.
pub function tz_rule(name: string)
    return engine_tz_rule(name)
end

## Returns 1 when the zone name or alias is bundled, 0 otherwise.
##
## ### Parameters
## - `name`: IANA zone name or alias.
##
## ### Returns
## 1 for known zones, 0 otherwise.
pub function tz_is_valid(name: string) -> int
    return engine_tz_is_valid(name)
end

## Returns all bundled IANA zone names.
##
## ### Parameters
## None.
##
## ### Returns
## Array of bundled zone name strings.
pub function tz_names() -> array
    return engine_tz_names()
end

## Returns 1 when daylight saving is active in the zone at the epoch.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## 1 when the daylight offset applies, 0 otherwise (fixed zones always 0).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function tz_is_dst(name: string, epoch: int) -> int
    return engine_tz_is_dst(name, epoch)
end

## Formats a minute offset as `+HH:MM` (zero renders as `+00:00`).
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Offset string such as `"+03:00"` or `"-05:00"`.
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function tz_offset_str(name: string, epoch: int) -> string
    return engine_tz_offset_str(name, epoch)
end

## Converts the current UTC time to a zoned calendar map.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
##
## ### Returns
## Zoned calendar map for `time()` (see `epoch_to_zoned` for the shape).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function zoned_now(name: string)
    return engine_zoned_now(name)
end

## Formats a zoned calendar map as `YYYY-MM-DD HH:MM:SS+HH:MM`.
##
## ### Parameters
## - `d`: Zoned calendar map from `epoch_to_zoned` (must carry `offset_min`).
##
## ### Returns
## Wall time with numeric offset, e.g. `"2024-01-01 08:00:00+08:00"`.
pub function format_zoned(d) -> string
    return engine_format_zoned(d)
end

## Resolves well-known aliases to canonical IANA names.
##
## ### Parameters
## - `name`: Candidate zone name or alias.
##
## ### Returns
## Canonical name when `name` is a known alias, otherwise `name` unchanged.
pub function tz_canonical(name: string) -> string
    return tzdata_canonical(name)
end

## Returns the bundled data revision identifier.
##
## ### Parameters
## None.
##
## ### Returns
## Opaque revision string for the bundled rule set.
pub function tzdata_version() -> string
    return engine_tzdata_version()
end

## Returns bundled zone names under a region prefix.
##
## ### Parameters
## - `prefix`: Region prefix such as `"Europe/"` or `"America/"`.
##
## ### Returns
## Matching IANA zone names (empty array when none match).
pub function tz_by_region(prefix: string) -> array
    return engine_tz_by_region(prefix)
end

## Returns bundled zone names using an offset.
##
## A zone matches when its standard offset equals `offset_min`, or when it
## has daylight saving and its daylight offset equals `offset_min`.
##
## ### Parameters
## - `offset_min`: Offset minutes east of UTC.
##
## ### Returns
## Matching IANA zone names (empty array when none match).
pub function tz_by_offset(offset_min: int) -> array
    return engine_tz_by_offset(offset_min)
end

## Returns the DST transition instants for a zone year.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `year`: Gregorian year.
##
## ### Returns
## Map with `has_dst` (1/0) and UTC epoch `start_utc`/`end_utc`
## (0 for fixed zones).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function tz_dst_range(name: string, year: int)
    return engine_tz_dst_range(name, year)
end

## Returns the next DST transition instant strictly after the epoch.
##
## ### Parameters
## - `name`: IANA zone name, alias, or Windows key.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Next transition UTC epoch, or null for fixed zones.
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function next_transition(name: string, epoch: int)
    return engine_next_transition(name, epoch)
end

## Parses a wall-time string in the zone into a UTC epoch.
##
## Accepts `YYYY-MM-DD`, `YYYY-MM-DDTHH:MM:SS`, and the space-separated
## form, with an optional ignored fraction (`.mmm`). No zone suffix is
## read: the wall reading belongs to `name`. The UTC-startup complement
## of `parse_iso8601`.
##
## ### Parameters
## - `s`: Wall-time string.
## - `name`: IANA zone name, alias, or Windows key.
##
## ### Returns
## UTC epoch seconds.
##
## ### Throws
## `TzError` when the string is malformed, the date is invalid, or the
## zone is not bundled.
##
## ### Examples
## ```alya
## parse_zoned("2024-01-01 08:00:00", "Asia/Shanghai") # 1704067200
## ```
pub function parse_zoned(s: string, name: string) -> int
    return engine_parse_zoned(s, name)
end

## Formats a zoned calendar map with a custom token pattern.
##
## Tokens: `YYYY` year, `MM` month, `DD` day, `HH` hour (24h), `mm`
## minute, `ss` second, `Z` numeric offset (`+HH:MM`), `A` abbreviation.
## Any other character passes through literally.
##
## ### Parameters
## - `d`: Zoned calendar map from `epoch_to_zoned` (must carry `offset_min`).
## - `fmt`: Token pattern.
##
## ### Returns
## Formatted wall-time string.
##
## ### Examples
## ```alya
## format_zoned_custom(w, "DD.MM.YYYY HH:mm Z") # "01.01.2024 08:00 +08:00"
## ```
pub function format_zoned_custom(d, fmt: string) -> string
    return engine_format_zoned_custom(d, fmt)
end

## Formats a zoned calendar map as RFC 3339 with numeric offset.
##
## ### Parameters
## - `d`: Zoned calendar map from `epoch_to_zoned` (must carry `offset_min`).
##
## ### Returns
## Wall time such as `"2024-01-01T08:00:00+08:00"`.
pub function format_rfc3339_zoned(d) -> string
    return engine_format_rfc3339_zoned(d)
end

## Adds whole hours on the absolute timeline, then re-zones.
##
## ### Parameters
## - `epoch`: UTC epoch seconds.
## - `name`: IANA zone name, alias, or Windows key.
## - `h`: Hours to add (may be negative).
##
## ### Returns
## Zoned calendar map `h` absolute hours later (see `epoch_to_zoned`).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function zoned_add_hours(epoch: int, name: string, h: int)
    return engine_zoned_add_hours(epoch, name, h)
end

## Adds calendar days keeping the wall clock, then re-zones.
##
## Unlike `zoned_add_hours`, the wall time is preserved: adding 1 day to
## midnight always yields midnight, even across a DST transition.
##
## ### Parameters
## - `epoch`: UTC epoch seconds.
## - `name`: IANA zone name, alias, or Windows key.
## - `n`: Days to add (may be negative).
##
## ### Returns
## Zoned calendar map `n` calendar days later with the same wall time.
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function zoned_add_days(epoch: int, name: string, n: int)
    return engine_zoned_add_days(epoch, name, n)
end

## Resolves a Windows zone key to IANA (mirrored table, see `sysinfo`).
##
## ### Parameters
## - `name`: Windows zone key or IANA name.
##
## ### Returns
## IANA zone name, or "" when unmappable.
##
## Requires the `windows` feature (default-on).
@cfg(feature = "windows")
pub function tz_windows_iana(name: string) -> string
    return tzdata_windows_iana(name)
end

## Returns the UTC offset in minutes active in the zone at the epoch.
##
## ### Parameters
## - `name`: IANA zone name or alias.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Offset minutes east of UTC (UTC+3 -> 180).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function tz_offset_min(name: string, epoch: int) -> int
    return engine_tz_offset_min(name, epoch)
end

## Returns the zone abbreviation active in the zone at the epoch.
##
## ### Parameters
## - `name`: IANA zone name or alias.
## - `epoch`: UTC epoch seconds.
##
## ### Returns
## Active abbreviation (`"EST"`/`"EDT"`).
##
## ### Throws
## `TzError` when the zone is not bundled.
pub function tz_abbrev(name: string, epoch: int) -> string
    return engine_tz_abbrev(name, epoch)
end

## Converts a UTC epoch to a zoned calendar map.
##
## ### Parameters
## - `epoch`: UTC epoch seconds.
## - `name`: IANA zone name or alias.
##
## ### Returns
## Calendar map (`year`, `month`, `day`, `hour`, `minute`, `second`,
## `weekday` with Sunday 0) plus `offset_min`, `abbr`, and `iana`.
##
## ### Throws
## `TzError` when the zone is not bundled.
##
## ### Examples
## ```alya
## let z = epoch_to_zoned(1704067200, "Asia/Shanghai")
## # z["hour"] == 8
## ```
pub function epoch_to_zoned(epoch: int, name: string)
    return engine_epoch_to_zoned(epoch, name)
end

## Converts a zoned wall-time map to a UTC epoch.
##
## Spring-forward gaps resolve forward, fall-back folds resolve to the
## standard-time (second) occurrence.
##
## ### Parameters
## - `d`: Calendar map with `year`, `month`, `day`, `hour`, `minute`, and `second`.
## - `name`: IANA zone name or alias.
##
## ### Returns
## UTC epoch seconds.
##
## ### Throws
## `TzError` when the zone is not bundled or the calendar date is invalid.
pub function zoned_to_epoch(d, name: string) -> int
    return engine_zoned_to_epoch(d, name)
end
